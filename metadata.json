{
  "name": "Net2Rust Network Diagnostics & Telemetry Suite",
  "version": "0.1.0",
  "description": "55 pure-Rust Windows & cross-platform network diagnostics, NDIS ETW packet capture, LAN, OSINT, and Wi-Fi/BLE tools with dual Win32/Iced GUIs, CLI, and policy-gated MCP server (R4 credential-free).",
  "repository": "https://github.com/adpaolucci/net2rust",
  "homepage": "https://net2rust.guap.ca",
  "license": "Apache-2.0",
  "binaries": [
    "net2rust",
    "net2rust-win32",
    "net2rust-iced",
    "net2rust-mcp"
  ],
  "requestFramePermissions": [],
  "majorCapabilities": [
    "13 socket, route, neighbor, interface, and ETW telemetry tools (net2rust-sockets)",
    "11 zero-driver NDIS ETW, optional Npcap, and offline PCAP/PCAPNG/ETL protocol analyzers (net2rust-capture)",
    "11 LAN ping, GeoIP traceroute, ARP/NetBIOS scan, SMB shares/open-files, and Wake-on-LAN tools (net2rust-lan)",
    "10 WHOIS/RDAP, offline GeoIP/OUI, DNS, hosting, and DNS/profile tools (net2rust-osint)",
    "10 Wi-Fi BSS/profile and Bluetooth Classic/BLE tools with zero key extraction (net2rust-radio)",
    "Native Win32 (WinSafe) & Iced 0.14 dual GUIs powered by guap-kit",
    "Policy-gated MCP JSON-RPC 2.0 stdio server (55 read-only TableProviders + 13 mutating ActionCommands)",
    "CSV/TSV/JSON/JSONL/HTML/Markdown exports with SHA-256/512 Merkle chain of custody"
  ],
  "domainCrates": [
    { "crate": "net2rust-sockets", "group": "sockets", "toolCount": 13 },
    { "crate": "net2rust-capture", "group": "capture", "toolCount": 11 },
    { "crate": "net2rust-lan", "group": "lan", "toolCount": 11 },
    { "crate": "net2rust-osint", "group": "osint", "toolCount": 10 },
    { "crate": "net2rust-radio", "group": "radio", "toolCount": 10 }
  ],
  "tools": [
    { "id": "sockets.ports", "crate": "net2rust-sockets", "nirsoft": "CurrPorts", "mutatingAction": true },
    { "id": "sockets.tcplog", "crate": "net2rust-sockets", "nirsoft": "TcpLogView", "mutatingAction": false },
    { "id": "sockets.live", "crate": "net2rust-sockets", "nirsoft": "LiveTcpUdpWatch", "mutatingAction": false },
    { "id": "sockets.app-net", "crate": "net2rust-sockets", "nirsoft": "AppNetworkCounter", "mutatingAction": false },
    { "id": "sockets.proc-tcp", "crate": "net2rust-sockets", "nirsoft": "ProcessTCPSummary", "mutatingAction": false },
    { "id": "sockets.tcp-errors", "crate": "net2rust-sockets", "nirsoft": "TCPConnectProblemView", "mutatingAction": false },
    { "id": "sockets.dns-log", "crate": "net2rust-sockets", "nirsoft": "DNSLookupView", "mutatingAction": false },
    { "id": "sockets.counters", "crate": "net2rust-sockets", "nirsoft": "NetworkCountersWatch", "mutatingAction": false },
    { "id": "sockets.adapter-watch", "crate": "net2rust-sockets", "nirsoft": "AdapterWatch", "mutatingAction": false },
    { "id": "sockets.interfaces", "crate": "net2rust-sockets", "nirsoft": "NetworkInterfacesView", "mutatingAction": false },
    { "id": "sockets.routes", "crate": "net2rust-sockets", "nirsoft": "NetRouteView", "mutatingAction": true },
    { "id": "sockets.neighbors", "crate": "net2rust-sockets", "nirsoft": "IPNeighborsView", "mutatingAction": false },
    { "id": "sockets.paths", "crate": "net2rust-sockets", "nirsoft": "IPPathTableView", "mutatingAction": false },
    { "id": "capture.sniff", "crate": "net2rust-capture", "nirsoft": "SmartSniff", "mutatingAction": false },
    { "id": "capture.traffic", "crate": "net2rust-capture", "nirsoft": "NetworkTrafficView", "mutatingAction": false },
    { "id": "capture.http", "crate": "net2rust-capture", "nirsoft": "HTTPNetworkSniffer", "mutatingAction": false },
    { "id": "capture.dns", "crate": "net2rust-capture", "nirsoft": "DNSQuerySniffer", "mutatingAction": false },
    { "id": "capture.dhcp", "crate": "net2rust-capture", "nirsoft": "DHCPLogView", "mutatingAction": false },
    { "id": "capture.mdns", "crate": "net2rust-capture", "nirsoft": "mDNSView", "mutatingAction": false },
    { "id": "capture.whois-lan", "crate": "net2rust-capture", "nirsoft": "WhoIsConnectedSniffer", "mutatingAction": false },
    { "id": "capture.cookies", "crate": "net2rust-capture", "nirsoft": "WebCookiesSniffer", "mutatingAction": false },
    { "id": "capture.website", "crate": "net2rust-capture", "nirsoft": "WebSiteSniffer", "mutatingAction": false },
    { "id": "capture.latency", "crate": "net2rust-capture", "nirsoft": "NetworkLatencyView", "mutatingAction": false },
    { "id": "capture.wifi-mon", "crate": "net2rust-capture", "nirsoft": "WifiChannelMonitor", "mutatingAction": false },
    { "id": "lan.ping", "crate": "net2rust-lan", "nirsoft": "PingInfoView", "mutatingAction": false },
    { "id": "lan.trace", "crate": "net2rust-lan", "nirsoft": "CountryTraceRoute", "mutatingAction": false },
    { "id": "lan.scan", "crate": "net2rust-lan", "nirsoft": "LANIPScanner", "mutatingAction": false },
    { "id": "lan.wnetwatcher", "crate": "net2rust-lan", "nirsoft": "Wireless Network Watcher", "mutatingAction": false },
    { "id": "lan.connect-log", "crate": "net2rust-lan", "nirsoft": "NetworkConnectLog", "mutatingAction": false },
    { "id": "lan.wol", "crate": "net2rust-lan", "nirsoft": "WakeMeOnLan", "mutatingAction": true },
    { "id": "lan.netbios", "crate": "net2rust-lan", "nirsoft": "NetBScanner", "mutatingAction": false },
    { "id": "lan.shares", "crate": "net2rust-lan", "nirsoft": "NetResView", "mutatingAction": false },
    { "id": "lan.openfiles", "crate": "net2rust-lan", "nirsoft": "NetworkOpenedFiles", "mutatingAction": true },
    { "id": "lan.resolve", "crate": "net2rust-lan", "nirsoft": "FastResolver", "mutatingAction": false },
    { "id": "lan.speedtest", "crate": "net2rust-lan", "nirsoft": "DownTester", "mutatingAction": false },
    { "id": "osint.ipnet", "crate": "net2rust-osint", "nirsoft": "IPNetInfo", "mutatingAction": false },
    { "id": "osint.whosip", "crate": "net2rust-osint", "nirsoft": "WhosIP", "mutatingAction": false },
    { "id": "osint.ipoffline", "crate": "net2rust-osint", "nirsoft": "IPInfoOffline", "mutatingAction": false },
    { "id": "osint.whois-domain", "crate": "net2rust-osint", "nirsoft": "WhoisThisDomain", "mutatingAction": false },
    { "id": "osint.whoiscl", "crate": "net2rust-osint", "nirsoft": "WhoisCL", "mutatingAction": false },
    { "id": "osint.dns", "crate": "net2rust-osint", "nirsoft": "DNSDataView", "mutatingAction": false },
    { "id": "osint.hosting", "crate": "net2rust-osint", "nirsoft": "DomainHostingView", "mutatingAction": false },
    { "id": "osint.oui", "crate": "net2rust-osint", "nirsoft": "MACAddressView", "mutatingAction": false },
    { "id": "osint.set-dns", "crate": "net2rust-osint", "nirsoft": "QuickSetDNS", "mutatingAction": true },
    { "id": "osint.net-profiles", "crate": "net2rust-osint", "nirsoft": "NetConnectChoose", "mutatingAction": true },
    { "id": "radio.wifi-info", "crate": "net2rust-radio", "nirsoft": "WifiInfoView", "mutatingAction": false },
    { "id": "radio.wifi-scan", "crate": "net2rust-radio", "nirsoft": "WirelessNetView", "mutatingAction": false },
    { "id": "radio.wifi-console", "crate": "net2rust-radio", "nirsoft": "WirelessNetConsole", "mutatingAction": false },
    { "id": "radio.wifi-conn", "crate": "net2rust-radio", "nirsoft": "WirelessConnectionInfo", "mutatingAction": false },
    { "id": "radio.wifi-profiles", "crate": "net2rust-radio", "nirsoft": "ManageWirelessNetworks", "mutatingAction": true },
    { "id": "radio.wifi-hosted", "crate": "net2rust-radio", "nirsoft": "HostedNetworkStarter", "mutatingAction": true },
    { "id": "radio.bt-view", "crate": "net2rust-radio", "nirsoft": "BluetoothView", "mutatingAction": false },
    { "id": "radio.bt-log", "crate": "net2rust-radio", "nirsoft": "BluetoothLogView", "mutatingAction": false },
    { "id": "radio.bt-cl", "crate": "net2rust-radio", "nirsoft": "BluetoothCL", "mutatingAction": false },
    { "id": "radio.ble", "crate": "net2rust-radio", "nirsoft": "BluetoothLEView", "mutatingAction": false }
  ],
  "actions": [
    { "id": "sockets.ports.close", "tool": "sockets.ports", "crate": "net2rust-sockets", "riskLevel": "PrivilegedMutating" },
    { "id": "sockets.routes.add", "tool": "sockets.routes", "crate": "net2rust-sockets", "riskLevel": "PrivilegedMutating" },
    { "id": "sockets.routes.delete", "tool": "sockets.routes", "crate": "net2rust-sockets", "riskLevel": "PrivilegedMutating" },
    { "id": "lan.wol.send", "tool": "lan.wol", "crate": "net2rust-lan", "riskLevel": "Mutating" },
    { "id": "lan.openfiles.close", "tool": "lan.openfiles", "crate": "net2rust-lan", "riskLevel": "PrivilegedMutating" },
    { "id": "osint.set-dns.apply", "tool": "osint.set-dns", "crate": "net2rust-osint", "riskLevel": "PrivilegedMutating" },
    { "id": "osint.net-profiles.connect", "tool": "osint.net-profiles", "crate": "net2rust-osint", "riskLevel": "PrivilegedMutating" },
    { "id": "osint.net-profiles.disconnect", "tool": "osint.net-profiles", "crate": "net2rust-osint", "riskLevel": "PrivilegedMutating" },
    { "id": "radio.wifi-profiles.set-order", "tool": "radio.wifi-profiles", "crate": "net2rust-radio", "riskLevel": "Mutating" },
    { "id": "radio.wifi-profiles.delete", "tool": "radio.wifi-profiles", "crate": "net2rust-radio", "riskLevel": "Mutating" },
    { "id": "radio.wifi-profiles.toggle-auto", "tool": "radio.wifi-profiles", "crate": "net2rust-radio", "riskLevel": "Mutating" },
    { "id": "radio.wifi-hosted.start", "tool": "radio.wifi-hosted", "crate": "net2rust-radio", "riskLevel": "PrivilegedMutating" },
    { "id": "radio.wifi-hosted.stop", "tool": "radio.wifi-hosted", "crate": "net2rust-radio", "riskLevel": "PrivilegedMutating" }
  ]
}
